<!-- MIGRATION_CLASSIFICATION: SCREEN_FLOW_CANDIDATE -->
<!-- This legacy Visualforce page is a candidate for later Flow/LWC evaluation. -->
<apex:page controller="BeatPlanningController" tabStyle="Account" lightningStylesheets="true">
    <apex:sectionHeader title="Visit Workbench" subtitle="Legacy console"/>
    <apex:pageMessages/>
    <apex:form>
        <apex:pageBlock title="Visit Workbench">
            <apex:pageBlockButtons>
                <apex:commandButton value="Refresh" action="{!refresh}"/>
                <apex:commandButton value="Plan" action="{!plan}" rendered="{!NOT(ISBLANK(selectedIds))}"/>
            </apex:pageBlockButtons>
            <apex:pageBlockSection columns="2">
                <apex:inputText value="{!searchKey}" label="Search"/>
                <apex:commandButton value="Search" action="{!search}"/>
            </apex:pageBlockSection>
            <apex:pageBlockTable value="{!rows}" var="row">
                <apex:column>
                    <apex:inputCheckbox value="{!row.selected}"/>
                </apex:column>
                    <apex:column value="{!row.label}"/>
                    <apex:column value="{!row.status}"/>
            </apex:pageBlockTable>
        </apex:pageBlock>
    </apex:form>
</apex:page>
